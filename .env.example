# ============================================================================
# rsmc-engine environment configuration
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in the secrets:   cp .env.example .env
#
# This single file serves BOTH run modes:
#   * Docker Compose - auto-loads `.env` and substitutes ${VAR} in the compose
#     files. JWT_SECRET and POSTGRES_PASSWORD have no defaults, so the stack
#     refuses to start until you set them.
#   * No Docker - the engine loads `.env` directly (via dotenvy). POSTGRES_* are
#     only used by the Docker path; for a manual setup, put the password
#     straight into DATABASE_URL.
#
# Settings are grouped below from most important (required to boot) to least
# (advanced tuning with safe defaults). You usually only need the first section.
#
# Precedence, lowest to highest: config.toml < APP__SECTION__KEY vars < bare
# vars (DATABASE_URL, JWT_SECRET, REDIS_URL, PORT).
# ============================================================================


# ============================================================================
# 1. REQUIRED - the engine will not start without these
# ============================================================================

# Secret used to sign JWTs. At least 16 characters (32+ recommended).
#   openssl rand -hex 32
JWT_SECRET=

# PostgreSQL password.
#   * Docker path: provisions the postgres container and is composed into the
#     app's DATABASE_URL automatically (so they can never drift apart).
#   * No-Docker path: put this same value into DATABASE_URL below.
POSTGRES_PASSWORD=

# No-Docker path only: full PostgreSQL connection string (PostgreSQL 16+).
# The Docker path ignores this and builds the URL from POSTGRES_* instead.
DATABASE_URL=postgres://rsmc:CHANGE_ME@localhost:5432/rsmc


# ============================================================================
# 2. DEPLOYMENT - set these for any real (non-localhost) deployment
# ============================================================================

# CORS allowlist (comma-separated). "*" is for local development ONLY: the
# engine sends credentialed requests, and the CORS standard forbids combining
# credentials with a wildcard, so a wildcard is rejected at startup in effect.
# In production set your real origin. Behind the reverse proxy (see
# docs/DEPLOY.md) the UI and API share one origin, so set that single origin.
# CORS_ORIGINS=https://chat.example.com

# Email (verification, password reset, email change). With no SMTP host set,
# action links are written to the server log instead of sent (handy for local
# testing). Set SMTP to deliver real mail. Verification is soft unless
# REQUIRE_VERIFICATION is true.
# APP__EMAIL__SMTP_HOST=smtp.example.com
# APP__EMAIL__SMTP_PORT=587
# APP__EMAIL__SMTP_USERNAME=apikey
# APP__EMAIL__SMTP_PASSWORD=secret
# APP__EMAIL__FROM_ADDRESS=no-reply@example.com
# APP__EMAIL__REQUIRE_VERIFICATION=false
# Public base URL used in email links; set it to the externally visible address
# (your proxy's URL), e.g. https://chat.example.com
# APP__EMAIL__PUBLIC_BASE_URL=https://chat.example.com
# APP__EMAIL__TOKEN_TTL_SECS=86400

# Docker data directories (Docker path only). Where the container stores
# persistent data on YOUR host; the stack bind-mounts them automatically.
# The container runs as UID 10001, so each directory must be writable by it:
#     mkdir -p <dir> && sudo chown 10001:10001 <dir>
# Defaults are ./uploads and ./backups next to the compose file.
# UPLOAD_HOST_DIR=./uploads
# BACKUP_HOST_DIR=./backups


# ============================================================================
# 3. SECURITY & PRIVACY - policy decisions, set once
# ============================================================================

# Dedicated key for encrypting MFA/TOTP secrets at rest. When unset, the key is
# derived from JWT_SECRET, which means rotating JWT_SECRET would force every MFA
# user to re-enroll. Set this (>= 16 chars) to decouple them, so rotating
# JWT_SECRET only logs users out and leaves MFA intact. New installs should set
# it; enabling it on an instance that already has MFA users means those users
# must re-enroll.
#   openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# Account-deletion policy (GDPR). "anonymize" (default) scrubs the user to a
# tombstone but keeps their messages so threads stay coherent. "hard_delete"
# removes their messages and files (can leave thread gaps, and is refused if the
# user still owns channels). See docs for the full tradeoff.
# APP__GDPR__DELETION_MODE=anonymize

# Message retention sweep, in days. 0 = keep messages forever (default).
# APP__RETENTION__DAYS=0


# ============================================================================
# 4. OPERATIONAL - commonly adjusted, safe to leave as-is
# ============================================================================

# HTTP listen port (also APP__SERVER__PORT).
PORT=8080

# Log filter (standard RUST_LOG syntax; overrides APP__LOGGING__LEVEL).
RUST_LOG=info,rsmc_engine=debug

# Redis-backed pub/sub for multi-instance realtime fan-out. Leave unset to run
# single-instance (in-process dispatch). The Docker stack sets this for you.
# REDIS_URL=redis://localhost:6379

# Docker path only: override the default DB user / name if you wish.
# POSTGRES_USER=rsmc
# POSTGRES_DB=rsmc


# ============================================================================
# 5. ADVANCED - tuning with sensible defaults; most installs never touch these
# ============================================================================

# APP__SERVER__HOST=0.0.0.0
# APP__SERVER__MAX_BODY_BYTES=26214400          # 25 MiB request body cap
# APP__DATABASE__MAX_CONNECTIONS=20
# APP__DATABASE__MIN_CONNECTIONS=2
# APP__DATABASE__ACQUIRE_TIMEOUT_SECS=10
# APP__DATABASE__AUTO_MIGRATE=true
# APP__AUTH__ACCESS_TOKEN_TTL_SECS=3600         # 1 hour
# APP__AUTH__REFRESH_TOKEN_TTL_SECS=2592000     # 30 days
# APP__STORAGE__UPLOAD_DIR=./uploads
# APP__STORAGE__MAX_FILE_BYTES=26214400         # 25 MiB
# APP__LOGGING__FORMAT=text                     # text | json
# APP__LOGGING__LEVEL=info

# Rate limiting: per-IP limit on auth endpoints (brute-force protection) and
# per-user limit on writes (flood protection). Enabled by default.
# APP__RATE_LIMIT__ENABLED=true
# APP__RATE_LIMIT__AUTH_MAX=10                   # auth attempts per IP per window
# APP__RATE_LIMIT__AUTH_WINDOW_SECS=60
# APP__RATE_LIMIT__WRITE_MAX=30                  # writes per user per window
# APP__RATE_LIMIT__WRITE_WINDOW_SECS=10
